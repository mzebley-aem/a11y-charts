{
  "name": "@a11y-charts/line-chart",
  "version": "0.0.0",
  "description": "Framework-free, accessible actual-versus-target line chart custom element",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/line-chart/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/line-chart/core.d.ts",
      "import": "./dist/core.js"
    },
    "./define": {
      "types": "./dist/types/line-chart/define.d.ts",
      "import": "./dist/define.js"
    },
    "./chart.js": "./dist/chart.js",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run smoke:packed",
    "smoke:packed": "node scripts/packed-smoke.mjs",
    "smoke:core": "npm run smoke:packed",
    "clean": "node scripts/clean.mjs",
    "dev": "vite demo --host 127.0.0.1",
    "demo:build": "vite build --config vite.demo.config.mjs && node scripts/inline-demo.mjs",
    "report:build": "vite build --config vite.report-demo.config.mjs",
    "test": "vitest run",
    "browser:test": "playwright test --config playwright.audit.config.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "artifacts:test": "playwright test --config playwright.artifacts.config.mjs",
    "gallery:dev": "vite --config vite.gallery.config.mjs",
    "gallery:build": "vite build --config vite.gallery.config.mjs",
    "a11y:audit": "node scripts/audit-accessibility.mjs",
    "browser:grouped": "playwright test --config playwright.grouped.config.mjs",
    "browser:themes": "playwright test --config playwright.themes.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@typescript/typescript6": "^6.0.2",
    "axe-core": "^4.14.0",
    "echarts": "^6.1.0",
    "es-module-lexer": "^2.3.2",
    "happy-dom": "^20.11.2",
    "rollup": "^4.64.12",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
