{
  "name": "a11y-charts",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev --prefix packages/line-chart",
    "start:bar": "npm run dev --prefix packages/bar-chart",
    "build": "npm run build --prefix packages/line-chart && npm run build --prefix packages/bar-chart",
    "watch": "npm run dev --prefix packages/line-chart",
    "test": "npm test --prefix packages/line-chart && npm test --prefix packages/bar-chart",
    "typecheck": "npm run typecheck --prefix packages/line-chart && npm run typecheck --prefix packages/bar-chart",
    "verify": "npm test && npm run typecheck && npm run build",
    "browser:test": "npm run browser:test --prefix packages/line-chart",
    "reference:start": "ng serve",
    "reference:build": "ng build",
    "reference:test": "ng test",
    "artifacts:test": "npm run build && npm run artifacts:test --prefix packages/line-chart",
    "gallery:dev": "npm run gallery:dev --prefix packages/line-chart",
    "gallery:build": "npm run gallery:build --prefix packages/line-chart",
    "site:build": "npm run gallery:build && npm run demo:build --prefix packages/line-chart && npm run demo:build --prefix packages/bar-chart && npm run report:build --prefix packages/line-chart && node scripts/assemble-demo-site.mjs",
    "gallery:typecheck": "packages/line-chart/node_modules/.bin/tsc -p demo-gallery/tsconfig.json",
    "browser:grouped": "npm run browser:grouped --prefix packages/line-chart",
    "browser:spp-apr": "npm exec --prefix packages/line-chart -- playwright test --config packages/line-chart/playwright.spp-apr.config.mjs",
    "browser:themes": "npm run browser:themes --prefix packages/line-chart"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "echarts": "^5.6.0",
    "ngx-echarts": "^18.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.20",
    "@angular/cli": "^18.2.20",
    "@angular/compiler-cli": "^18.2.13",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^5.5.4"
  }
}
