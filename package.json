{
  "name": "a11y-charts",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev --prefix packages/target-line-chart",
    "start:bar": "npm run dev --prefix packages/bar-chart",
    "build": "npm run build --prefix packages/target-line-chart && npm run build --prefix packages/bar-chart && npm run build --prefix packages/segmented-bar-chart",
    "watch": "npm run dev --prefix packages/target-line-chart",
    "test": "npm test --prefix packages/target-line-chart && npm test --prefix packages/bar-chart && npm test --prefix packages/segmented-bar-chart",
    "typecheck": "npm run typecheck --prefix packages/target-line-chart && npm run typecheck --prefix packages/bar-chart && npm run typecheck --prefix packages/segmented-bar-chart",
    "verify": "npm run test:scripts && npm test && npm run typecheck && npm run build",
    "browser:test": "npm run browser:test --prefix packages/target-line-chart",
    "reference:start": "ng serve",
    "reference:build": "ng build",
    "reference:test": "ng test",
    "artifacts:test": "npm run build && npm run artifacts:test --prefix packages/target-line-chart",
    "browser:grouped": "npm run browser:grouped --prefix packages/target-line-chart",
    "browser:spp-apr": "npm exec --prefix packages/target-line-chart -- playwright test --config packages/target-line-chart/playwright.spp-apr.config.mjs",
    "browser:themes": "npm run browser:themes --prefix packages/target-line-chart",
    "browser:dispute-resolution": "npm exec --prefix packages/target-line-chart -- playwright test --config packages/target-line-chart/playwright.dispute-resolution.config.mjs",
    "browser:segmented": "npm exec --prefix packages/target-line-chart -- playwright test --config packages/target-line-chart/playwright.segmented.config.mjs",
    "release:version": "node scripts/set-version.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:scripts": "node --test scripts/release-scripts.test.mjs",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run packages:dist && npm run build --prefix docs",
    "packages:dist": "node packages/target-line-chart/scripts/build.mjs && node packages/bar-chart/scripts/build.mjs && node packages/segmented-bar-chart/scripts/build.mjs",
    "deploy:build": "npm run packages:dist && npm run demo:build --prefix packages/target-line-chart && npm run demo:build --prefix packages/bar-chart && npm run build --prefix docs && node scripts/assemble-deploy-site.mjs",
    "browser:docs": "npm exec --prefix packages/target-line-chart -- playwright test --config packages/target-line-chart/playwright.docs.config.mjs",
    "docs:typecheck": "npm exec --prefix docs -- tsc -p docs/src/examples/tsconfig.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "echarts": "^5.6.0",
    "ngx-echarts": "^18.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.20",
    "@angular/cli": "^18.2.20",
    "@angular/compiler-cli": "^18.2.13",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^5.5.4"
  }
}
