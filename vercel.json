{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix packages/target-line-chart && npm ci --prefix packages/bar-chart && npm ci --prefix packages/segmented-bar-chart && npm ci --prefix docs",
  "buildCommand": "npm run deploy:build",
  "outputDirectory": "dist/site",
  "redirects": [
    { "source": "/gallery", "destination": "/examples/", "permanent": true },
    { "source": "/gallery/", "destination": "/examples/", "permanent": true },
    { "source": "/gallery/demo/report-demo.html", "destination": "/reports/report-demo/", "permanent": true },
    { "source": "/gallery/demo/:file", "destination": "/demo/:file", "permanent": true },
    { "source": "/gallery/:page(spp-apr|dispute-resolution)", "destination": "/reports/:page/", "permanent": true },
    { "source": "/gallery/:page(spp-apr|dispute-resolution)/", "destination": "/reports/:page/", "permanent": true },
    { "source": "/gallery/:page(spp-apr|dispute-resolution)/:path+", "destination": "/reports/:page/:path+", "permanent": true },
    { "source": "/gallery/segmented", "destination": "/examples/segmented-bar-charts/", "permanent": true },
    { "source": "/gallery/segmented/", "destination": "/examples/segmented-bar-charts/", "permanent": true },
    { "source": "/gallery/segmented/:path+", "destination": "/examples/segmented-bar-charts/", "permanent": true },
    { "source": "/demo/report-demo.html", "destination": "/reports/report-demo/", "permanent": true },
    { "source": "/:page(spp-apr|dispute-resolution)", "destination": "/reports/:page/", "permanent": true },
    { "source": "/:page(spp-apr|dispute-resolution)/", "destination": "/reports/:page/", "permanent": true },
    { "source": "/:page(spp-apr|dispute-resolution)/:path+", "destination": "/reports/:page/:path+", "permanent": true },
    { "source": "/segmented", "destination": "/examples/segmented-bar-charts/", "permanent": true },
    { "source": "/segmented/", "destination": "/examples/segmented-bar-charts/", "permanent": true },
    { "source": "/segmented/:path+", "destination": "/examples/segmented-bar-charts/", "permanent": true },
    { "source": "/charts/line-chart", "destination": "/charts/target-line-chart/", "permanent": true },
    { "source": "/charts/line-chart/", "destination": "/charts/target-line-chart/", "permanent": true },
    { "source": "/examples/line-charts", "destination": "/examples/target-line-charts/", "permanent": true },
    { "source": "/examples/line-charts/", "destination": "/examples/target-line-charts/", "permanent": true },
    { "source": "/demo/line-chart.html", "destination": "/demo/target-line-chart.html", "permanent": true }
  ]
}
